{
  "name": "vacinacao-infantil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de controlo de vacinação infantil (Cloudflare Workers + D1 + R2, offline-first)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed:gerar": "node database/seeds/gerar-seed.mjs",
    "db:migrar:local": "wrangler d1 migrations apply vacinacao --local",
    "db:seed:local": "wrangler d1 execute vacinacao --local --file=database/seeds/0001_catalogo.sql",
    "test": "node --test"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "lucide-static": "^1.73.0",
    "wrangler": "^4.163.0"
  }
}
